* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    background: radial-gradient(circle, #24103d, #080510);
    color: white;
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
}

.game {
    width: 90%;
    max-width: 900px;
    text-align: center;
}

h1 {
    text-shadow: 0 0 15px #c56cff;
}

.stats {
    display: flex;
    justify-content: center;
    gap: 35px;
    margin: 20px 0;
    font-size: 20px;
}

.stats span {
    color: #e98cff;
    font-weight: bold;
}

button {
    padding: 14px 30px;
    border: 2px solid #e98cff;
    border-radius: 30px;
    background: transparent;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 0 15px #e98cff;
}

button:hover {
    background: #e98cff;
    color: #16091f;
}

#gameArea {
    position: relative;
    width: 100%;
    height: 500px;
    margin-top: 25px;
    border: 2px solid #6f398c;
    border-radius: 20px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.35);
}

#star {
    position: absolute;
    display: none;
    font-size: 45px;
    cursor: pointer;
    user-select: none;
    filter: drop-shadow(0 0 15px white);
}

#star:hover {
    transform: scale(1.2);
}

#message {
    margin-top: 20px;
    font-size: 22px;
    min-height: 30px;
}
