const startButton = document.getElementById("start");
const star = document.getElementById("star");
const gameArea = document.getElementById("gameArea");

const scoreText = document.getElementById("score");
const timeText = document.getElementById("time");
const recordText = document.getElementById("record");
const message = document.getElementById("message");

let score = 0;
let time = 30;
let gameRunning = false;
let timer;

let record = localStorage.getItem("starRecord") || 0;

recordText.textContent = record;

function moveStar() {

    const areaWidth = gameArea.clientWidth;
    const areaHeight = gameArea.clientHeight;

    const starSize = 50;

    const x = Math.random() * (areaWidth - starSize);
    const y = Math.random() * (areaHeight - starSize);

    star.style.left = x + "px";
    star.style.top = y + "px";
}

function startGame() {

    score = 0;
    time = 30;
    gameRunning = true;

    scoreText.textContent = score;
    timeText.textContent = time;

    message.textContent = "";

    startButton.textContent = "ИГРА ИДЁТ...";

    star.style.display = "block";

    moveStar();

    clearInterval(timer);

    timer = setInterval(() => {

        time--;

        timeText.textContent = time;

        if (time <= 0) {
            endGame();
        }

    }, 1000);
}

function endGame() {

    gameRunning = false;

    clearInterval(timer);

    star.style.display = "none";

    startButton.textContent = "ИГРАТЬ СНОВА";

    if (score > record) {

        record = score;

        localStorage.setItem("starRecord", record);

        recordText.textContent = record;

        message.textContent =
            "🏆 НОВЫЙ РЕКОРД! " + score + " очков!";

    } else {

        message.textContent =
            "Игра окончена! Ты набрала " + score + " очков.";
    }
}

star.addEventListener("click", () => {

    if (!gameRunning) return;

    score++;

    scoreText.textContent = score;

    moveStar();
});

startButton.addEventListener("click", startGame);
